{
  "name": "compostate",
  "version": "0.5.1",
  "private": false,
  "description": "Composable and reactive state management library",
  "keywords": [
    "custom-elements",
    "preact",
    "react",
    "reactivity",
    "signals",
    "state-management"
  ],
  "homepage": "https://github.com/lxsmnsyc/compostate",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/compostate/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/compostate.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "preact": [
        "./dist/preact.d.ts"
      ],
      "element": [
        "./dist/element.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "development": {
        "import": {
          "types": "./dist/dev/index.d.ts",
          "default": "./dist/dev/index.js"
        },
        "require": {
          "types": "./dist/dev/index.d.cts",
          "default": "./dist/dev/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "development": {
        "import": {
          "types": "./dist/dev/react.d.ts",
          "default": "./dist/dev/react.js"
        },
        "require": {
          "types": "./dist/dev/react.d.cts",
          "default": "./dist/dev/react.cjs"
        }
      },
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./preact": {
      "development": {
        "import": {
          "types": "./dist/dev/preact.d.ts",
          "default": "./dist/dev/preact.js"
        },
        "require": {
          "types": "./dist/dev/preact.d.cts",
          "default": "./dist/dev/preact.cjs"
        }
      },
      "import": {
        "types": "./dist/preact.d.ts",
        "default": "./dist/preact.js"
      },
      "require": {
        "types": "./dist/preact.d.cts",
        "default": "./dist/preact.cjs"
      }
    },
    "./element": {
      "development": {
        "import": {
          "types": "./dist/dev/element.d.ts",
          "default": "./dist/dev/element.js"
        },
        "require": {
          "types": "./dist/dev/element.d.cts",
          "default": "./dist/dev/element.cjs"
        }
      },
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.13.2",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "preact": "^10",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
